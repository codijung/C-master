        private void ExportBundlesToJson(List<ColumnListBundle> bundles, string filePath)
        {
            try
            {
                // 1. C# 객체 리스트를 JSON 문자열로 변환 (Formatting.Indented: 보기 좋게 들여쓰기)
                string jsonOutput = JsonConvert.SerializeObject(bundles, Formatting.Indented);

                // 2. 문자열을 실제 파일로 저장 (UTF-8로 인코딩)
                File.WriteAllText(filePath, jsonOutput, Encoding.UTF8);
            }
            catch (System.Exception ex)
            {
                Application.DocumentManager.MdiActiveDocument.Editor.WriteMessage(
                    $"\n[오류] JSON 파일 저장 중 오류 발생: {ex.Message}");
            }
        }
