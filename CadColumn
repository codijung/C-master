        private SelectionSet SelectAllScheduleObjects(Editor ed)
        {
            PromptSelectionOptions selOpts = new PromptSelectionOptions();
            selOpts.MessageForAdding = "\n일람표 전체(헤더, 데이터, 라인, 상세도)를 선택하세요: ";
            PromptSelectionResult selRes = ed.GetSelection(selOpts);
            return selRes.Status == PromptStatus.OK ? selRes.Value : null;
        }

        private void ExtractScheduleEntities(Database db, SelectionSet sset, Editor ed,
            out List<ColumnListTextData> allTexts,
            out List<Line> horizontalLines,
            out List<Line> verticalLines,
            out List<Entity> allDrawingObjects)
        {
            allTexts = new List<ColumnListTextData>();
            horizontalLines = new List<Line>();
            verticalLines = new List<Line>();
            allDrawingObjects = new List<Entity>();
            const double lineTolerance = 1e-6;

            Stack<Tuple<Entity, Matrix3d>> ProcessingStack = new Stack<Tuple<Entity, Matrix3d>>();

            using (Transaction tr = db.TransactionManager.StartTransaction())
            {
                foreach (SelectedObject so in sset)
                {
                    Entity ent = tr.GetObject(so.ObjectId, OpenMode.ForRead) as Entity;
                    if (ent == null) continue;
                    ProcessingStack.Push(new Tuple<Entity, Matrix3d>(ent, Matrix3d.Identity));
                }

                // (class1.cs -> ExtractScheduleEntities 함수 내부)
                // ...
                while (ProcessingStack.Count > 0)
                {
                    var (currEnt, currXform) = ProcessingStack.Pop();
                    string text = null;
                    Point3d pos = Point3d.Origin;

                    try
                    {
                        // (⭐ 수정된 Line 처리 로직)
                        if (currEnt is Line line)
                        {
                            Line transformedLine = line.GetTransformedCopy(currXform) as Line;
                            if (transformedLine == null) continue;

                            // 1. 그리드(Grid)용 리스트에 추가 (조건부)
                            if (Math.Abs(transformedLine.Delta.Y) < lineTolerance)
                                horizontalLines.Add(transformedLine);
                            else if (Math.Abs(transformedLine.Delta.X) < lineTolerance)
                                verticalLines.Add(transformedLine);

                            // 2. 상세도 분석용 리스트에 "모든" 선 추가 (무조건)
                            // (J-Bar는 수평/수직선이므로, 이 코드가 반드시 필요합니다)
                            allDrawingObjects.Add(transformedLine);
                        }
                        else if (currEnt is Polyline pline)
                        {
                            ProcessPolyline(pline, currXform, ProcessingStack);
                        }
                        else if (currEnt is DBText dbT) { text = dbT.TextString; pos = dbT.Position.TransformBy(currXform); }
                        else if (currEnt is MText mT) { text = mT.Text; pos = mT.Location.TransformBy(currXform); }
                        else if (currEnt is AttributeReference att) { text = att.TextString; pos = att.Position.TransformBy(currXform); }

                        // (블록 분해)
                        else if (currEnt is BlockReference blk)
                        {
                            BlockTableRecord btr = (BlockTableRecord)tr.GetObject(blk.BlockTableRecord, OpenMode.ForRead);
                            Matrix3d newXform = blk.BlockTransform.PreMultiplyBy(currXform);
                            foreach (ObjectId id in btr)
                            {
                                Entity entInBlock = tr.GetObject(id, OpenMode.ForRead) as Entity;
                                if (entInBlock != null)
                                {
                                    ProcessingStack.Push(new Tuple<Entity, Matrix3d>(entInBlock, newXform));
                                }
                            }
                        }
                        else if (currEnt is Circle circle)
                        {
                            allDrawingObjects.Add(circle.GetTransformedCopy(currXform));
                        }
                        else if (currEnt is Dimension dim)
                        {
                            allDrawingObjects.Add(dim.GetTransformedCopy(currXform));
                        }
                        else
                        {
                            // (기타 다른 객체들도 추가)
                            allDrawingObjects.Add(currEnt.GetTransformedCopy(currXform));
                        }

                        // (텍스트 저장)
                        if (!string.IsNullOrWhiteSpace(text))
                        {
                            allTexts.Add(new ColumnListTextData(currEnt, text, pos));
                        }
                    }
                    catch (System.Exception ex)
                    {
                        ed.WriteMessage($"\n[경고] 객체(Handle: {currEnt.Handle}) 처리 중 오류: {ex.Message}");
                    }
                } // end while
                  // ...

                tr.Commit();
            }
        }

        private void ProcessPolyline(Polyline pline, Matrix3d currXform, Stack<Tuple<Entity, Matrix3d>> ProcessingStack)
        {
            if (pline.NumberOfVertices < 2) return;
            for (int i = 0; i < pline.NumberOfVertices; i++)
            {
                SegmentType segType = pline.GetSegmentType(i);
                if (segType == SegmentType.Line)
                {
                    LineSegment2d seg = pline.GetLineSegment2dAt(i);
                    Line segmentLine = new Line(
                        new Point3d(seg.StartPoint.X, seg.StartPoint.Y, pline.Elevation),
                        new Point3d(seg.EndPoint.X, seg.EndPoint.Y, pline.Elevation)
                    );
                    ProcessingStack.Push(new Tuple<Entity, Matrix3d>(segmentLine, currXform));
                }
            }
        }

        private List<ColumnListElementsSearchY> DefineRowZones(List<ColumnListTextData> allTexts, List<Line> horizontalLines, ColumnListElements elements)
        {
            var searchYSections = new List<ColumnListElementsSearchY>();
            var headerSetNoSpace = elements.ToHeaderSetNoSpace();

            var masterHeaders = allTexts
                .Where(h => h.TextNoSpace == elements.Sign.Replace(" ", ""))
                .OrderByDescending(h => h.Position.Y)
                .ToList();

            var otherHeaders = allTexts
                .Where(h => h.TextNoSpace != elements.Sign.Replace(" ", "") &&
                            headerSetNoSpace.Contains(h.TextNoSpace))
                .ToList();

            for (int i = 0; i < masterHeaders.Count; i++)
            {
                var masterHeader = masterHeaders[i];
                var searchY = new ColumnListElementsSearchY();

                var lineAboveMaster = horizontalLines.Where(L => L.StartPoint.Y > masterHeader.Position.Y).OrderBy(L => L.StartPoint.Y - masterHeader.Position.Y).FirstOrDefault();
                if (lineAboveMaster == null) continue;
                searchY.SectionOverallMaxY = lineAboveMaster.StartPoint.Y;

                if (i == masterHeaders.Count - 1)
                {
                    var lowestLine = horizontalLines.Where(L => L.StartPoint.Y < searchY.SectionOverallMaxY).OrderBy(L => L.StartPoint.Y).FirstOrDefault();
                    searchY.SectionOverallMinY = lowestLine?.StartPoint.Y ?? double.MinValue;
                }
                else
                {
                    var nextMasterHeader = masterHeaders[i + 1];
                    var nextLineAbove = horizontalLines.Where(L => L.StartPoint.Y > nextMasterHeader.Position.Y).OrderBy(L => L.StartPoint.Y - nextMasterHeader.Position.Y).FirstOrDefault();
                    if (nextLineAbove == null) continue;
                    searchY.SectionOverallMinY = nextLineAbove.StartPoint.Y;
                }

                var headersInThisSection = otherHeaders.Concat(new[] { masterHeader })
                    .Where(h => h.Position.Y < searchY.SectionOverallMaxY && h.Position.Y > searchY.SectionOverallMinY)
                    .ToList();

                foreach (var header in headersInThisSection)
                {
                    // (⭐ X좌표 필터링 적용된 버전)
                    double headerX = header.Position.X;
                    var lineAbove = horizontalLines
                        .Where(L =>
                            L.StartPoint.Y > header.Position.Y &&
                            L.StartPoint.Y <= searchY.SectionOverallMaxY &&
                            (headerX >= Math.Min(L.StartPoint.X, L.EndPoint.X) &&
                             headerX <= Math.Max(L.StartPoint.X, L.EndPoint.X))
                        )
                        .OrderBy(L => L.StartPoint.Y - header.Position.Y)
                        .FirstOrDefault();

                    var lineBelow = horizontalLines
                        .Where(L =>
                            L.StartPoint.Y < header.Position.Y &&
                            L.StartPoint.Y >= searchY.SectionOverallMinY &&
                            (headerX >= Math.Min(L.StartPoint.X, L.EndPoint.X) &&
                             headerX <= Math.Max(L.StartPoint.X, L.EndPoint.X))
                        )
                        .OrderBy(L => header.Position.Y - L.StartPoint.Y)
                        .FirstOrDefault();
                    // (⭐ 적용 끝)

                    if (lineAbove == null || lineBelow == null) continue;

                    string key = header.TextNoSpace;
                    if (key == elements.Sign.Replace(" ", "")) { searchY.SignMaxY = lineAbove.StartPoint.Y; searchY.SignMinY = lineBelow.StartPoint.Y; }
                    else if (key == elements.Section.Replace(" ", "")) { searchY.SectionMaxY = lineAbove.StartPoint.Y; searchY.SectionMinY = lineBelow.StartPoint.Y; }
                    else if (key == elements.MainBar.Replace(" ", "")) { searchY.MainBarMaxY = lineAbove.StartPoint.Y; searchY.MainBarMinY = lineBelow.StartPoint.Y; }
                    else if (key == elements.HoopMid.Replace(" ", "")) { searchY.HoopMidMaxY = lineAbove.StartPoint.Y; searchY.HoopMidMinY = lineBelow.StartPoint.Y; }
                    else if (key == elements.HoopEnd.Replace(" ", "")) { searchY.HoopEndMaxY = lineAbove.StartPoint.Y; searchY.HoopEndMinY = lineBelow.StartPoint.Y; }
                }

                searchYSections.Add(searchY);
            }
            return searchYSections;
        }

        private List<ColumnListBundle> DefineColumnBundles(
            List<ColumnListTextData> allTexts,
            List<Line> verticalLines,
            List<ColumnListElementsSearchY> searchYSections,
            ColumnListElements elements)
        {
            var allBundles = new List<ColumnListBundle>();
            var headerSetNoSpace = elements.ToHeaderSetNoSpace();
            var columnAnchors = new List<Tuple<ColumnListTextData, ColumnListElementsSearchY>>();

            foreach (var section in searchYSections)
            {
                var anchorsInThisSection = allTexts
                    .Where(t => t.Position.Y < section.SignMaxY && t.Position.Y > section.SignMinY &&
                                !headerSetNoSpace.Contains(t.TextNoSpace))
                    .ToList();

                foreach (var anchor in anchorsInThisSection)
                {
                    columnAnchors.Add(new Tuple<ColumnListTextData, ColumnListElementsSearchY>(anchor, section));
                }
            }

            foreach (var pair in columnAnchors)
            {
                var anchorText = pair.Item1;
                var section = pair.Item2;
                double textY = anchorText.Position.Y;

                var lineLeft = verticalLines.Where(L => L.StartPoint.X < anchorText.Position.X && Math.Min(L.StartPoint.Y, L.EndPoint.Y) <= textY && Math.Max(L.StartPoint.Y, L.EndPoint.Y) >= textY).OrderByDescending(L => L.StartPoint.X).FirstOrDefault();
                var lineRight = verticalLines.Where(L => L.StartPoint.X > anchorText.Position.X && Math.Min(L.StartPoint.Y, L.EndPoint.Y) <= textY && Math.Max(L.StartPoint.Y, L.EndPoint.Y) >= textY).OrderBy(L => L.StartPoint.X).FirstOrDefault();

                if (lineLeft != null && lineRight != null)
                {
                    allBundles.Add(new ColumnListBundle
                    {
                        Sign = anchorText.Text,
                        MaxX = lineRight.StartPoint.X,
                        MinX = lineLeft.StartPoint.X,
                        RowSection = section
                    });
                }
            }
            return allBundles;
        }

        private ColumnListTextData FindTextInBounds(
            List<ColumnListTextData> allTexts,
            double minX, double maxX,
            double minY, double maxY)
        {
            return allTexts.FirstOrDefault(t =>
                t.Position.X >= minX && t.Position.X <= maxX &&
                t.Position.Y >= minY && t.Position.Y <= maxY
            );
        }

        private void PopulateBundleData(List<ColumnListBundle> allBundles, List<ColumnListTextData> allTexts)
        {
            foreach (var bundle in allBundles)
            {
                double minX = bundle.MinX;
                double maxX = bundle.MaxX;
                var yMap = bundle.RowSection;

                try
                {
                    var mainBarText = FindTextInBounds(allTexts, minX, maxX, yMap.MainBarMinY, yMap.MainBarMaxY);
                    if (mainBarText != null)
                    {
                        var parts = mainBarText.Text.Split('-');
                        if (parts.Length == 2)
                        {
                            bundle.MainBarNumber = parts[0].Trim();
                            bundle.MainBarDiameter = parts[1].Trim();
                        }
                    }

                    var hoopMidText = FindTextInBounds(allTexts, minX, maxX, yMap.HoopMidMinY, yMap.HoopMidMaxY);
                    if (hoopMidText != null)
                    {
                        var parts = hoopMidText.Text.Split('@');
                        if (parts.Length == 2)
                        {
                            bundle.HoopMidDiameter = parts[0].Trim();
                            bundle.HoopMidInterval = parts[1].Trim();
                        }
                    }

                    var hoopEndText = FindTextInBounds(allTexts, minX, maxX, yMap.HoopEndMinY, yMap.HoopEndMaxY);
                    if (hoopEndText != null)
                    {
                        var parts = hoopEndText.Text.Split('@');
                        if (parts.Length == 2)
                        {
                            bundle.HoopEndDiameter = parts[0].Trim();
                            bundle.HoopEndInterval = parts[1].Trim();
                        }
                    }
                }
                catch (System.Exception ex)
                {
                    Application.DocumentManager.MdiActiveDocument.Editor.WriteMessage(
                        $"\n[경고] '{bundle.Sign}' 데이터 파싱 중 오류: {ex.Message}");
                }
            }
        }


        private void PrintBundleList(Editor ed, List<ColumnListBundle> bundles)
        {
            ed.WriteMessage($"\n--- ColumnListBundle 분석 완료 ({bundles.Count}개) ---");
            int i = 1;

            foreach (var bundle in bundles.OrderByDescending(b => b.RowSection.SectionOverallMaxY).ThenBy(b => b.MinX))
            {
                ed.WriteMessage($"\n[Bundle {i++}]");
                ed.WriteMessage($"  Sign: {bundle.Sign}");
                ed.WriteMessage($"  X-Range: {bundle.MinX:F2} ~ {bundle.MaxX:F2}");
                ed.WriteMessage($"    -> MainBar:   {bundle.MainBarNumber}-{bundle.MainBarDiameter}");
                ed.WriteMessage($"    -> Hoop(Mid): {bundle.HoopMidDiameter}@{bundle.HoopMidInterval}");
                ed.WriteMessage($"    -> Hoop(End): {bundle.HoopEndDiameter}@{bundle.HoopEndInterval}");

                if (bundle.DetailAnalysis != null)
                {
                    var detail = bundle.DetailAnalysis;
                    ed.WriteMessage($"    -> (Detail) Size: {detail.Width} x {detail.Height}");
                    ed.WriteMessage($"    -> (Detail) MainBars: {detail.TotalMainBars} 개");
                    ed.WriteMessage($"    -> (Detail) JBars: {detail.JBars.Count} 개");
                }
                else
                {
                    ed.WriteMessage($"    -> (Detail) 분석 데이터 없음.");
                }
            }
        }

        private void DrawBundleVisuals(Database db, Editor ed, List<ColumnListBundle> bundles)
        {
            using (Transaction tr = db.TransactionManager.StartTransaction())
            {
                try
                {
                    BlockTable bt = tr.GetObject(db.BlockTableId, OpenMode.ForRead) as BlockTable;
                    BlockTableRecord ms = tr.GetObject(bt[BlockTableRecord.ModelSpace], OpenMode.ForWrite) as BlockTableRecord;

                    foreach (var bundle in bundles)
                    {
                        double minX = bundle.MinX;
                        double maxX = bundle.MaxX;
                        double minY = bundle.RowSection.SectionOverallMinY;
                        double maxY = bundle.RowSection.SectionOverallMaxY;

                        Polyline rect = new Polyline();
                        rect.AddVertexAt(0, new Point2d(minX, minY), 0, 0, 0);
                        rect.AddVertexAt(1, new Point2d(maxX, minY), 0, 0, 0);
                        rect.AddVertexAt(2, new Point2d(maxX, maxY), 0, 0, 0);
                        rect.AddVertexAt(3, new Point2d(minX, maxY), 0, 0, 0);
                        rect.Closed = true;
                        rect.ColorIndex = 1; // Red

                        ms.AppendEntity(rect);
                        tr.AddNewlyCreatedDBObject(rect, true);

                        MText dataText = new MText();
                        var content = new StringBuilder();
                        content.AppendLine($@"{{\L{bundle.Sign}}}");
                        if (!string.IsNullOrEmpty(bundle.MainBarNumber))
                        {
                            content.AppendLine($"Main: {bundle.MainBarNumber}-{bundle.MainBarDiameter}");
                        }
                        if (bundle.DetailAnalysis != null)
                        {
                            content.AppendLine($@"Detail: {bundle.DetailAnalysis.Width}x{bundle.DetailAnalysis.Height} ({bundle.DetailAnalysis.TotalMainBars}bars)");
                        }
                        dataText.Contents = content.ToString();

                        Point3d center = new Point3d((minX + maxX) / 2.0, (bundle.RowSection.SignMinY + bundle.RowSection.SignMaxY) / 2.0, 0);
                        dataText.Location = center;
                        dataText.Attachment = AttachmentPoint.MiddleCenter;

                        double rectHeight = bundle.RowSection.SignMaxY - bundle.RowSection.SignMinY;
                        dataText.TextHeight = rectHeight / 4.0;
                        dataText.Width = (maxX - minX) * 0.9;
                        dataText.ColorIndex = 2; // Yellow

                        ms.AppendEntity(dataText);
                        tr.AddNewlyCreatedDBObject(dataText, true);
                    }

                    tr.Commit();
                    ed.WriteMessage($"\n--- {bundles.Count}개의 번들 데이터 시각화를 도면에 그렸습니다. ---");
                }
                catch (System.Exception ex)
                {
                    ed.WriteMessage($"\n[오류] 시각화 도중 오류 발생: {ex.Message}");
                    tr.Abort();
                }
            }
        }
    }
