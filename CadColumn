                        ed.WriteMessage($"\n[경고] '{bundle.Sign}'의 단면(Section) Y좌표가 정의되지 않았습니다.");
                        continue;
                    }

                    Point3d pt1 = new Point3d(minX, minY, 0);
                    Point3d pt2 = new Point3d(maxX, maxY, 0);

                    // (디버깅용 노란색 사각형 그리기 코드 제거)

                    // (⭐ 핵심) class2.cs의 함수 호출
                    SectionElements analysisResults = AnalyzeSectionDetailByRange(
                        pt1, pt2,
                        allDrawingObjects
                    );

                    if (analysisResults != null)
                    {
                        bundle.DetailAnalysis = analysisResults;
                        ed.WriteMessage($"\n> '{bundle.Sign}' 단면 분석 완료 (W:{analysisResults.Width}, H:{analysisResults.Height})");
                    }
                    else
                    {
                        ed.WriteMessage($"\n> '{bundle.Sign}' 단면 분석 실패 (범위 내 객체 부족).");
                    }
                }

                // ... (7단계 '단면 상세도 분석 완료' 메시지 출력 다음) ...
                ed.WriteMessage("\n--- 단면 상세도 분석 완료 ---");

                // --- 8. (⭐ 신규) 파일로 내보내기 ---

                // 사용자의 바탕화면 경로를 가져옵니다.
                string desktopPath = Environment.GetFolderPath(Environment.SpecialFolder.Desktop);
                // 저장할 파일 경로와 이름을 지정합니다.
                string savePath = Path.Combine(desktopPath, "ScheduleAnalysis_Output.json");

                // JSON 내보내기 함수 호출
                ExportBundlesToJson(allBundles, savePath);

                ed.WriteMessage($"\n--- {allBundles.Count}개 번들 데이터를 JSON 파일로 내보냈습니다 ---");
                ed.WriteMessage($"경로: {savePath}");



                // 8. 최종 번들 리스트를 출력 (콘솔)
                //PrintBundleList(ed, allBundles);

                // 9. 시각화 함수 호출 (도면)
                //DrawBundleVisuals(db, ed, allBundles);

            }
            catch (System.Exception ex)
            {
                Application.ShowAlertDialog($"오류 발생:\n{ex.Message}\n{ex.StackTrace}");
            }
